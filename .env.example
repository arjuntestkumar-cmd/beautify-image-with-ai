# Copy to .env to override any default. Every value below is already the default,
# so the service runs correctly with no .env file at all.
#
# Locally  : the app reads ./.env itself (app/config.py, pydantic-settings).
# On Docker: .env is deliberately kept OUT of the image (.dockerignore) and is delivered to the
#            container by the `env_file:` entry in docker-compose.yml. Edit it on the host and
#            `docker compose up -d` - no rebuild, env is read when the container starts.
#            Anything in the compose file's `environment:` block wins over this file.
# See deploy/AWS.md -> "Changing configuration".

APP_ENV=development
# The origin this site is reached at, e.g. https://khushify.ai — used only to make the social
# share-card tags absolute, which Open Graph requires. Leave it empty and the origin is taken
# from each request (honouring X-Forwarded-Proto/Host), which is correct both for a bare IP and
# for a domain behind a reverse proxy. Set it only if something in front rewrites Host.
PUBLIC_BASE_URL=
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=*

# --- hardware ---
# ENABLE_CUDA is honoured only when torch reports a working CUDA device; otherwise CPU is used.
ENABLE_CUDA=true
ENABLE_HALF_PRECISION=true
GPU_DEVICE=cuda:0
DEFAULT_TILE_SIZE=400
TILE_PADDING=16

# Set true ONLY to test wiring without model weights. Output becomes a plain resize — not AI.
MOCK_MODE=false

# --- limits ---
# Higher than they used to be because the pipeline no longer holds a whole large photo in
# memory at once (see app/pipeline/chunked.py). A photo over MAX_INPUT_PIXELS is fitted to it
# and processed rather than rejected.
MAX_UPLOAD_BYTES=67108864
MAX_INPUT_PIXELS=80000000
MAX_OUTPUT_PIXELS=160000000
MAX_OUTPUT_SIDE=16384
DOWNSCALE_OVERSIZE_INPUT=true

# Photos at or below this longest side get a real 2x upscale; larger ones are beautified at
# their native size. Raise it if you want big photos upscaled too (much slower on CPU).
AUTO_UPSCALE_MAX_SIDE=1600

# --- storage (local, temporary — there is no database) ---
RESULT_RETENTION_MINUTES=30
CLEANUP_INTERVAL_SECONDS=120

# --- processing ---
# One heavy job at a time is the load control: everyone else waits in an ordered queue and is
# told their position. Raising this does not make the server faster, it makes it fall over.
WORKER_CONCURRENCY=1
MAX_QUEUED_JOBS=64
# The job deadline scales with the photo, so a large file gets the time it needs and only a
# genuinely hung job is stopped.
JOB_TIMEOUT_SECONDS=900
JOB_TIMEOUT_SECONDS_PER_MEGAPIXEL=90
JOB_TIMEOUT_SECONDS_MAX=5400

# --- chunked processing ---
# Past this many pixels the heavy stages run over overlapping tiles, so peak memory follows the
# tile and not the photo. Lower the tile sizes first if the machine is memory-starved.
CHUNK_THRESHOLD_PIXELS=4000000
CHUNK_TILE_SIZE=768
CHUNK_OVERLAP=48
# Quoted on the model's INPUT side: RealESRGANer runs its 4x network before scaling back down,
# so 384 px in is a 1536 px tensor.
MODEL_CHUNK_TILE_SIZE=384
MODEL_CHUNK_OVERLAP=24

OUTPUT_QUALITY=92
# Keep an un-styled copy of each result so the beautification filter can be changed or removed
# without re-running any of the models. Costs one extra file per job for the retention window.
KEEP_UNFILTERED_BASE=true
BASE_QUALITY=96
